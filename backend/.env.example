# Copy this file to .env and fill in real values. .env is gitignored.

# Resend API Key for the contact form email.
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=

# Cloudinary (video/image storage for the portfolio admin panel).
# Create a free account at https://cloudinary.com, then copy these three
# values from your Dashboard page.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# The password typed at /admin/login to manage portfolio videos.
ADMIN_PASSWORD=

# Random secret used to sign the admin login session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
